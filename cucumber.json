{
  "default": {
    "paths": [
      "tests/day_2/exercise_8/features/**/*.feature"
    ],
    "require": [
      "tests/day_2/exercise_8/support/**/*.ts",
      "tests/day_2/exercise_8/features/steps/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "formatOptions": {
